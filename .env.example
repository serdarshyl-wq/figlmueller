# The Sanity project the studio at /admin reads and writes.
# Organisation: FIGLMUELLER - project: figlmueller
NEXT_PUBLIC_SANITY_PROJECT_ID=z9xgg97x
NEXT_PUBLIC_SANITY_DATASET=production
# The API date the queries are pinned to. Moving it forward opts into newer
# behaviour; leaving it is what keeps today's queries answering the same way.
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-21

# The mailbox a filled-in enquiry form is sent through. These are secrets and
# do not carry the NEXT_PUBLIC_ prefix: they are read on the server only, by
# /api/enquiry, and never reach the browser.
#
# Any provider will do - these are the settings the mailbox's own host gives
# out. Port 465 is treated as the encrypted one; anything else is STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@figlmueller.ae
SMTP_PASS=
# What the mail is sent as. Left empty, it is sent as SMTP_USER. It has to be
# an address the mailbox above is allowed to send from.
MAIL_FROM=FIGLMUELLER <no-reply@figlmueller.ae>
# Where enquiries land. This is written in the studio instead - under Let's
# talk - and is only read from here if the studio has been left empty.
ENQUIRY_INBOX=
